# Telegrobsidian configuration.
#
# Copy to /etc/telegrobsidian/env, fill in the secrets and run
#   chmod 600 /etc/telegrobsidian/env
# The systemd unit reads this file; you can also `set -a; . ./.env; set +a`
# for a foreground run. Environment variables already set in the shell win over
# the file, and every value below shows its default.

# ---------------------------------------------------------------------------
# Vault (required)
# ---------------------------------------------------------------------------
# Absolute path of the Obsidian vault. Created if missing.
OBSIDIAN_VAULT_PATH=/var/lib/obsidian/vault

# Sub-directories handled by the daemon (relative to the vault).
NOTION_MIRROR_DIR=notion_sync      # Notion -> vault; never pushed back
TELEGRAM_INBOX_DIR=telegram_inbox  # Telegram captures
OBSIDIAN_PUSH_DIR=obsidian_sync    # reserved for outbound-only files
STATE_FILE=                        # default: <vault>/.telegrobsidian/state.json

# ---------------------------------------------------------------------------
# Notion (optional: leave the keys empty to run Telegram-only)
# ---------------------------------------------------------------------------
# Internal integration token: https://www.notion.so/my-integrations
NOTION_API_KEY=
# Database id: the 32 hex characters in the database URL (dashes optional).
# The database must be shared with the integration (Connections -> add).
NOTION_DATABASE_ID=
NOTION_VERSION=2022-06-28
NOTION_BASE_URL=https://api.notion.com
NOTION_POLL_INTERVAL_SEC=60        # 5..86400
NOTION_PAGE_CACHE_MAX=5000         # how many page versions to remember

# ---------------------------------------------------------------------------
# Telegram (optional: the webhook endpoint works without a token)
# ---------------------------------------------------------------------------
# Bot token from @BotFather; needed to register the webhook and for --self-test.
TELEGRAM_BOT_TOKEN=
# Optional: restrict nothing here, Telegram only delivers to registered URLs.
TELEGRAM_CHAT_ID=
# Random string; Telegram then sends it as X-Telegram-Bot-Api-Secret-Token and
# the daemon rejects any call without it. Strongly recommended.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL of this daemon (e.g. https://bot.example.com). When set,
# the webhook is registered automatically at startup.
TELEGRAM_PUBLIC_URL=
TELEGRAM_API_BASE=https://api.telegram.org

# ---------------------------------------------------------------------------
# HTTP endpoint
# ---------------------------------------------------------------------------
WEBHOOK_BIND=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_MAX_PAYLOAD_BYTES=1048576

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How long a write by the daemon keeps suppressing the matching inotify event.
DEDUP_COOLDOWN_MS=5000
# Burst window: a path is only considered settled after it has been quiet this
# long. Larger values batch editor autosaves, smaller values sync sooner.
DEBOUNCE_MS=300
# A file is not read until its mtime is at least this old (half-written files).
QUIESCE_MS=200
# How long a shutdown may spend finishing queued work.
DRAIN_TIMEOUT_SEC=5
# Re-scan the vault for new directories (inotify cannot report nested ones).
WATCHER_RESCAN_SEC=120
HTTP_CONNECT_TIMEOUT_SEC=5
HTTP_READ_TIMEOUT_SEC=15
# Push changes made inside NOTION_MIRROR_DIR (risks ping-ponging).
NOTION_PUSH_MIRROR_FILES=false
# On a first run (no state file) the files already present in the vault are
# registered as synced instead of being uploaded, so an existing vault does not
# turn into hundreds of pages. Set to true to upload them, or run --once.
PUSH_EXISTING_ON_STARTUP=false
# Set SSL_CERT_FILE from a well-known location when it is not already set.
USE_SYSTEM_CA_BUNDLE=true
# Attempts for 429/5xx answers. Connection errors are never retried blindly,
# because a page may already have been created.
MAX_PUSH_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info        # trace | debug | info | warn | error
LOG_TIMESTAMPS=true
LOG_JSON=false        # one JSON object per line, for log shippers
